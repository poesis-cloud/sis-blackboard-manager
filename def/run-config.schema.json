{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://gsm-sourcer/run-config/v1",
  "title": "RunConfig",
  "description": "Operator-supplied configuration for a Run. The Initializer combines this with the Pack's Instructions Provider output to build the immutable SourcingRunContext.",
  "type": "object",
  "required": [
    "sourcingPacks",
    "profile"
  ],
  "properties": {
    "sourcingPacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "uri"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "description": "Versioned gsmarc:// Pack URI."
          },
          "disabledKnowledgeSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ksBudgetOverrides": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": true
    },
    "instructionsPayload": {
      "type": "object",
      "additionalProperties": true,
      "description": "Operator input forwarded verbatim to the Pack's Instructions Provider."
    },
    "resolverOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "highestConfidence",
          "firstWriter",
          "failOnConflict",
          "userMediated",
          "collectAll"
        ]
      }
    },
    "externalToolBindings": {
      "type": "array",
      "description": "Operator narrows the Pack's requestedExternalTools to actual host paths. Sandbox execve is restricted to these resolved bindings.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "resolvedPath",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "resolvedPath": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "runInvariants": {
      "type": "object",
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "quiescenceThreshold": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "determinismMode": {
          "type": "string",
          "enum": [
            "strict",
            "lenient"
          ],
          "default": "lenient"
        }
      },
      "additionalProperties": false
    },
    "checkpoints": {
      "type": "object",
      "properties": {
        "A": {
          "type": "boolean",
          "default": false
        },
        "B": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
