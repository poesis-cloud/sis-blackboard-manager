{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://gsm-sourcer/run-config/v1",
  "title": "RunConfig",
  "description": "Configuration for one Run of GSM Sourcer.",
  "type": "object",
  "required": ["sourceContext", "sourcingPacks", "profile"],
  "properties": {
    "sourceContext": {
      "type": "object",
      "required": ["kind", "uri"],
      "properties": {
        "kind": {
          "type": "string",
          "description": "Opaque to engine; meaningful to a DiscoveryKS that recognizes it (e.g. 'git-repo', 'local-path', 'openapi-doc')."
        },
        "uri": { "type": "string" },
        "credentialsRef": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sourcingPacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uri"],
        "properties": {
          "uri": {
            "type": "string",
            "format": "uri",
            "description": "Versioned gsmarc:// URI of a Sourcing Pack. No implicit 'latest'."
          },
          "ksOverrides": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["ksId"],
              "properties": {
                "ksId": { "type": "string", "format": "uri" },
                "enabled": { "type": "boolean" },
                "budget": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["axis1", "axis2"],
      "properties": {
        "axis1": {
          "type": "string",
          "description": "Intake filter profile (Axis-1, depth). Default: Functional. Future: Reachability, TestCorroborated, HotspotWeighted, CoverageDriven.",
          "enum": ["Functional", "Reachability", "TestCorroborated", "HotspotWeighted", "CoverageDriven"]
        },
        "axis2": {
          "type": "string",
          "description": "Mechanism granularity / consolidation profile (Axis-2). Default: Standard.",
          "enum": ["Standard", "Coarse", "Fine", "BoundaryOnly"]
        }
      },
      "additionalProperties": false
    },
    "targetCatalogues": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "description": "Catalogue archetype roots a contributor may attach (e.g. TOGAF, SAFe, ISO 25000). Restricts which ArchetypingKS contributions are eligible to fire."
    },
    "checkpoints": {
      "type": "object",
      "properties": {
        "checkpointA": { "type": "boolean", "default": true },
        "checkpointB": { "type": "boolean", "default": true },
        "synchronous": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "inference": {
      "type": "object",
      "properties": {
        "providerRef": { "type": "string" },
        "model": { "type": "string" },
        "modelVersion": { "type": "string" },
        "temperature": { "type": "number" },
        "maxTokens": { "type": "integer" },
        "cacheEnabled": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "globalBudget": {
      "type": "object",
      "properties": {
        "wallClockMs": { "type": "integer" },
        "inferenceCostUsd": { "type": "number" },
        "defmanCalls": { "type": "integer" }
      }
    }
  },
  "additionalProperties": false
}
