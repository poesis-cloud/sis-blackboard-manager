@startuml gsm-sourcer-blackboard-framework-contracts

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #57606A
  FontColor #24292F
}
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F8FA
skinparam packageBorderColor #57606A
skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

frame "CD - GSM Sourcer - Blackboard Framework Contracts (engine-supplied interfaces and descriptors)" {

  interface KnowledgeSource {
    +List<Contribution> contribute(ControlContext ctx)
  }

  class KnowledgeSourceDescriptor <<descriptor>> {
    id : URI                         (gsmarc://...)
    family : enum                    (DiscoveryKS | RelationKS |
                                      InterfaceKS | IdentificationKS |
                                      ReconciliationKS | ArchetypeKS |
                                      StatementShapingKS | GranularityKS |
                                      ConfidenceSynthesisKS)
    targetBlackboard : enum          (source | target)
    direction : enum                 (BOTTOM_UP | TOP_DOWN; default BOTTOM_UP)
    writesPanel : String             (panel name; one; must belong to targetBlackboard)
    writesSlots : List<String>
    readsPanels : List<String>       (BOTTOM_UP: subset of dependencyPanels*
                                      TOP_DOWN: may include descendants;
                                      sanctioned only for GranularityKS)
    triggerPredicate : Class<? extends KsTriggerPredicate>
                                     (FQN of a Java class)
    parallelSafe : boolean
    determinismDefault : enum        (DETERMINISTIC | NON_DETERMINISTIC)
    resolverHint : enum              (highestConfidence | firstWriter |
                                      failOnConflict |
                                      collectAll | compose)
    inferenceServiceNeeded : boolean
    defmanExplorationNeeded : boolean
    externalTools : List<ToolReq>    (name + versionSpec)
    budget : Budget
    --
    NO dependsOn : KSs are unaware of each other.
    Ordering is data-driven via triggerPredicate.
    Engine routes the KS to SourceController or
    TargetController based on targetBlackboard.
  }

  interface InstructionsProvider {
    +InstructionsResult provide(InstructionsContext ctx)
  }

  class InstructionsProviderDescriptor <<descriptor>> {
    id : URI
    instructionsPayloadSchemaRef : URI
    network : enum (deny | allow)
    externalTools : List<ToolReq>
    budget : Budget
    --
    Invoked exactly once per Run by Initializer,
    BEFORE either Controller starts. Returns domain-specific
    RunContext properties; NEVER writes to either Blackboard.
  }

  interface ControlContext <<runtime>> {
    +SourcingRunContext runContext()
    +BlackboardView blackboard()         (the Controller's targeted Blackboard)
    +BlackboardResolutionView sourceResolution()     (Target-side only; null on Source side)
    +InferenceService inference()        (if declared)
    +DefManExplorationService defman()   (if declared)
    +Tool tool(String name)              (if declared + bound)
    +BundleStore bundleStore()
    +DiagnosticReporter diagnostics()
  }

  interface BlackboardView <<read-only>> {
    +Optional<Object> resolved(String panelName, String identityKey)
    +List<Contribution> contributionsOf(String panelName, String identityKey)
    +List<Contribution> contributionsOfSlot(String panelName, String slot)
    +boolean contributedBy(URI ksId, String identityKey)
    +void post(Contribution c)
  }

  interface BlackboardResolutionView <<read-only,immutable>> {
    +boolean has(String packPanelName, String identityKey)
    +List<Contribution> contributionsOf(String packPanelName, String identityKey)
    +List<Contribution> contributionsOfSlot(String packPanelName, String slot)
  }

  class Contribution <<wire,abstract>> {
    id : String
    panel : String                   (panel name)
    slot : String
    value : Object
    contributorKsId : URI            (engine-set)
    confidence : double [0..1]
    rationale : String?
    evidence : List<EvidenceRef>     (optional; replaces Wave-9-dropped Evidence panel)
    cacheKey : String                (required if producing KS is NON_DETERMINISTIC)
    derivedFrom : List<String>
    supersedes : List<String>        (engine-set on override)
    diagnostics : List<Diagnostic>
    createdAt : Instant
    --
    Sealed over: SourceContribution (no extra fields, hosted on SourceBlackboard)
              | TargetContribution (adds targetIdentityKey: String, hosted on TargetBlackboard).
    No `kind` or `determinism` field on Contribution: provenance class is read
    from contributorKsId; determinism is a property of the producing KS.
  }

  class EvidenceRef <<value>> {
    source : String?     (URI, file path, or other identifier)
    kind : String        (e.g. STATIC_SCAN, LLM_AGREEMENT, COUNTER_EXAMPLE)
    weight : double      ([-1..1]; negative = counter-evidence)
    note : String?
  }

  ' ============================================================
  ' ENGINE-SUPPLIED SERVICE CONTRACTS
  ' (all reachable from ControlContext; KSs depend on these)
  ' ============================================================

  interface KsTriggerPredicate <<plug-in,pure>> {
    +boolean test(BlackboardView view, SourcingRunContext ctx)
  }

  note right of KsTriggerPredicate
    Pack-supplied class. Pure read against the typed
    `BlackboardView` and the frozen `SourcingRunContext`.
    The Controller invokes `test(...)` once per scheduling tick
    to decide whether the KS is firable. No DSL, no scripting.
    See also note `N_TriggerPredicate` for the BlackboardView
    accessor catalogue.
  end note

  interface CompletionPredicate <<plug-in,pure>> {
    +boolean isComplete(BlackboardView view, SourcingRunContext ctx)
  }

  note right of CompletionPredicate
    Optional Pack- or operator-supplied class. When set in
    `RunConfig.runInvariants.completionPredicate`, the engine
    polls it after each Controller iteration; a `true` return
    forces the active phase to terminate even if quiescence has
    not been reached. Loaded by FQN at Run start.
  end note

  interface ContributionResolver <<engine,strategy>> {
    +Object resolve(List<Contribution> conflicting,\n                  ContributionSlot slot,\n                  SourcingRunContext ctx)
  }

  note right of ContributionResolver
    Per-`(panel, slot)` strategy that folds competing
    Contributions into a single resolved value visible via
    `BlackboardView.resolved(panel, identityKey)`. Engine ships
    five built-in strategies (selected by enum
    `ContributionResolver` in
    `gsm-sourcer-blackboard-framework.puml`):
    `highestConfidence`, `firstWriter`, `failOnConflict`,
    `collectAll`, `compose`. RunConfig may override per slot via
    `resolvers."<Panel>.<Slot>"`. Pack code MUST NOT implement
    custom resolvers; the closed strategy set is engine-owned.
  end note

  interface BundleStore <<engine,service>> {
    +URI write(String pathHint, byte[] bytes)
    +URI write(String pathHint, InputStream in)
    +InputStream read(URI bundleUri)
    +boolean exists(URI bundleUri)
  }

  note right of BundleStore
    Run-scoped content-addressable store for materialised
    artefacts (repository working copy, SBOM, tool outputs,
    cached LLM responses). The Pack's Instructions Provider is
    typically the only producer that needs `network = allow`;
    KSs read deterministically from BundleStore (no live
    network, enforcing I-13). Bundle URIs are stable for the
    Run; lifecycle ends with the Run.
  end note

  interface InferenceService <<engine,service,non-deterministic>> {
    +InferenceResponse complete(InferenceRequest req)
    +InferenceResponse classify(ClassificationRequest req)
  }

  note right of InferenceService
    Engine-mediated LLM/inference gateway. Available to KSs that
    declare `inferenceServiceNeeded = true` in their descriptor.
    The engine memoises calls by `cacheKey` (computed from
    `(contributorKsId, all read inputs)`) so a NON_DETERMINISTIC
    KS sees stable outputs across iterations and Run replays
    (I-4). Engine-enforced budget: token / call counts are
    debited from `KnowledgeSourceDescriptor.budget`.
  end note

  interface DefManExplorationService <<engine,service>> {
    +List<ArchetypeRef> findArchetypes(SubjectKind kind)
    +ArchetypeDefinition load(URI archetypeRef)
    +Optional<URI> resolveSchema(URI archetypeRef)
  }

  note right of DefManExplorationService
    Read-only window onto the Definition Manager's published
    Archetype catalogue. Available to KSs that declare
    `defmanExplorationNeeded = true` in their descriptor
    (notably `ArchetypeMatchingKS`). NEVER mutates the Definition
    Manager; mutation is the Pipeline's Registration stage's
    responsibility, not a KS concern.
  end note

  interface Tool <<engine,service,sandboxed>> {
    +String name()
    +Path hostPath()
    +ExecResult exec(List<String> args, ExecOptions opts)
  }

  note right of Tool
    Sandboxed handle to one external host binary, obtained via
    `ctx.tool(name)`. The engine returns a `Tool` only if BOTH
    (a) the Pack declared `name` in
    `pack-manifest.requestedExternalTools[]` AND
    (b) the operator bound `name` in
    `RunConfig.externalToolBindings[]` (3-layer authorization,
    I-10). Sandbox `execve` allowlist is the third enforcement
    layer. Output flows through `BundleStore`; stdout/stderr are
    captured into `ExecResult`.
  end note

  interface DiagnosticReporter <<engine,service>> {
    +void report(Diagnostic d)
    +void warn(String code, String msg, JsonObject ctx)
    +void error(String code, String msg, JsonObject ctx)
  }

  note right of DiagnosticReporter
    Append-only Run-scoped diagnostic channel. KSs report
    structured findings (validation failures, low-confidence
    flags, ambiguity warnings, tool errors). Diagnostics are
    surfaced in `BlackboardView` aggregates
    (`view.validationFailed(identityKey)`) and in the Run audit
    artefact persisted alongside `targetResolution`.
  end note

  ' ============================================================
  ' RELATIONSHIPS
  ' ============================================================

  KnowledgeSource --> KnowledgeSourceDescriptor : declared by
  KnowledgeSource --> ControlContext : uses (sole IO)
  KnowledgeSource --> KsTriggerPredicate : declares (FQN)
  KnowledgeSource --> Contribution : returns 0..n
  ControlContext --> BlackboardView
  ControlContext --> BlackboardResolutionView : (Target side only)
  ControlContext --> BundleStore
  ControlContext --> InferenceService : (if declared)
  ControlContext --> DefManExplorationService : (if declared)
  ControlContext --> Tool : (one per bound name)
  ControlContext --> DiagnosticReporter
  ContributionResolver ..> Contribution : folds N -> 1
  Contribution --> EvidenceRef : evidence
  InstructionsProvider --> InstructionsProviderDescriptor : declared by
  InstructionsProvider --> BundleStore : materialises inputs

  note as N_TriggerPredicate
    **KsTriggerPredicate accessor catalogue**

    `BlackboardView` exposes the typed accessors a predicate needs:

    Per-identity:
      view.resolved(panelName, identityKey)
      view.contributionsOf(panelName, identityKey)
      view.contributionsOfSlot(panelName, slot)
      view.contributedBy(thisKsId, identityKey)
      ctx.scope().includes(identityKey)

    Target-side only (read frozen Source):
      ctx.sourceResolution().has(packPanelName, identityKey)
      ctx.sourceResolution().contributionsOf(packPanelName, identityKey)

    Revision (re-fire even when upstream is resolved):
      view.confidenceBelow(identityKey, threshold)
      view.statementAmbiguous(identityKey)
      view.validationFailed(identityKey)

    Aggregate (cross-identity):
      view.count(predicate)

    Example predicate body:

      ```
      // ArchetypeMatchingKS
      return view.resolved("Definition", id) != null
          && view.contributionsOf("Archetype", id).isEmpty()
          && !view.contributedBy(thisKsId(), id);
      ```
  end note

  note as N_Tools
    **External tools (3-layer authorization)**
    1. Pack manifest declares upper bound
       (requestedExternalTools[])
    2. RunConfig binds names -> host paths
       (externalToolBindings[])
    3. Sandbox execve is restricted to bindings
    KSs invoke via ctx.tool(name); engine returns
    a sandboxed handle. Output flows through BundleStore.
  end note

  ' ============================================================
  ' PLUG-IN DEPLOYMENT MANIFEST
  ' (intra-JVM, Pack-side type; loaded by PluginLoader)
  ' ============================================================

  class PackManifest <<descriptor,record>> {
    id : URI                         (versioned gsmarc:// URI of the Pack)
    name : String
    instructionsProvider : URI       (URI of the Pack's InstructionsProviderDescriptor)
    panels : List<PanelDeclaration>  (Pack-owned Source Blackboard panels)
    extendsPanels : Map<TargetPanel, Map<SlotName, SlotBinding>>
                                     (additive slots onto engine-owned
                                      Definition / Archetype / Statement)
    knowledgeSources : List<URI>     (URIs of KS descriptors shipped by the Pack)
    requestedExternalTools : List<ToolReq>
    --
    Engine-owned Target panels MUST NOT appear in `panels[]`;
    use `extendsPanels` to add additive slots only.
    Wave 9: dropped Granularity / Evidence / Confidence panels
    are no longer accepted anywhere.
  }

  class PanelDeclaration <<descriptor,record>> {
    name : String                    (Pack-namespaced; SHOULD match `<packPrefix>:<PanelName>`)
    description : String?
    slots : Map<SlotName, SlotBinding>   (closed; minProperties = 1)
    dependencyPanels : List<String>      (DAG edges; engine-owned panel names allowed)
  }

  class SlotBinding <<descriptor,record>> {
    schemaUri : URI                  (versioned gsmarc:// URI of the per-slot JSON Schema)
    defaultResolver : ContributionResolver
    --
    Engine resolves `schemaUri` by looking up the resource bundled
    in the Pack JAR at `/META-INF/gsmarc/<URI-path-tail>`; falls
    back to the configured Schema Registry if any. No network fetch.
    RunConfig may override `defaultResolver` per `(panel, slot)`.
  }

  class ToolReq <<value,record>> {
    name : String
    versionSpec : String
  }

  class Budget <<value,record>> {
    wallClockMs : int?               (>= 1)
    memoryMb : int?                  (>= 1)
    inferenceTokens : int?           (>= 0)
    defmanCalls : int?               (>= 0)
  }

  class Diagnostic <<value,record>> {
    severity : enum                  (info | warning | error | fatal)
    code : String
    message : String
    sourceKsId : URI?                (KS that emitted the diagnostic, if any)
    context : Map<String, Object>?   (free-form payload)
  }

  ' ============================================================
  ' RELATIONSHIPS (deployment + value composition)
  ' ============================================================

  PackManifest *-- "0..*" PanelDeclaration : panels
  PackManifest *-- "0..*" ToolReq : requestedExternalTools
  PanelDeclaration *-- "1..*" SlotBinding : slots
  KnowledgeSourceDescriptor *-- "0..*" ToolReq : externalTools
  KnowledgeSourceDescriptor *-- "0..1" Budget : budget
  InstructionsProviderDescriptor *-- "0..*" ToolReq : externalTools
  InstructionsProviderDescriptor *-- "0..1" Budget : budget
  DiagnosticReporter ..> Diagnostic : reports
  Contribution *-- "0..*" Diagnostic : diagnostics
}

@enduml
