{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://gsm-sourcer/pipeline/ValidatedAscriptionDraft/v1",
  "title": "ValidatedAscriptionDraft",
  "description": "Engine-internal Pipeline record produced by the Validation stage from a converged target-spine tuple (one Definition + its resolved Archetype + Statement). NOT a Blackboard panel. Wave 9: built from the 3-layer Target Blackboard (Definition / Archetype / Statement); the dropped Granularity panel's verdict is now sourced from the `Definition.Verdict` slot, the dropped Evidence panel's signals are sourced from the `Contribution.evidence` arrays attached on the contributing Statement Contributions, and the dropped Confidence panel's score is sourced from the resolved Statement Contribution's `confidence` value (after ConfidenceSynthesisKS folding via `compose`).",
  "type": "object",
  "required": [
    "id",
    "definitionContributionId",
    "subjectKind",
    "identityKey",
    "archetypeRefs",
    "statement",
    "validationStatus",
    "resolverDecisions",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "definitionContributionId": {
      "type": "string"
    },
    "subjectKind": {
      "type": "string",
      "enum": [
        "Structure",
        "Mechanism",
        "Effector",
        "Receptor",
        "Interaction",
        "Archetype",
        "Directive",
        "Norm"
      ]
    },
    "identityKey": {
      "type": "string"
    },
    "archetypeRefs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "statement": {
      "type": "object",
      "additionalProperties": true
    },
    "granularityVerdict": {
      "type": "string",
      "enum": [
        "keep",
        "drop",
        "splitInto",
        "mergeWith"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "validationStatus": {
      "type": "string",
      "enum": [
        "OK",
        "FAILED"
      ]
    },
    "validationDiagnostics": {
      "type": "array",
      "items": {
        "$ref": "../types/Diagnostic.schema.json"
      }
    },
    "resolverDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "panel",
          "selectedContributionId",
          "resolver"
        ],
        "properties": {
          "panel": {
            "type": "string",
            "enum": [
              "Definition",
              "Archetype",
              "Statement"
            ]
          },
          "selectedContributionId": {
            "type": "string"
          },
          "competingContributionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolver": {
            "type": "string",
            "enum": [
              "highestConfidence",
              "firstWriter",
              "failOnConflict",
              "collectAll",
              "compose"
            ]
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidenceContributionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
