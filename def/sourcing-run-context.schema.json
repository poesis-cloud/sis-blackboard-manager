{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://gsm-sourcer/sourcing-run-context/v1",
  "title": "SourcingRunContext",
  "description": "Immutable per-Run engine state, distinct from the Blackboard. Built by the Initializer in three deterministic substeps: (1) Instructions Provider returns instructionsPayload + profile + Pack-typed user config; (2) Scope Builder derives scope from profile (engine default; Pack may override); (3) Focus Builder derives focus from scope + RunConfig (engine default; Pack may override). Frozen after Initialization, before the Blackboard Builder substep stands up the panels. Read-only access via ControlContext.runContext().",
  "type": "object",
  "required": [
    "runId",
    "profile",
    "instructionsPayload",
    "scope",
    "focus",
    "runInvariants"
  ],
  "properties": {
    "runId": {
      "type": "string"
    },
    "profile": {
      "type": "object",
      "additionalProperties": true,
      "description": "Pack-typed enums (e.g. axis1, axis2)."
    },
    "instructionsPayload": {
      "type": "object",
      "additionalProperties": true,
      "description": "Domain-specific payload returned by the Instructions Provider; conforms to the Pack's instructionsPayloadSchemaRef."
    },
    "scope": {
      "type": "object",
      "properties": {
        "inclusion": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "exclusion": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "axisDecision": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "focus": {
      "type": "object",
      "properties": {
        "priorityBands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "identityPattern",
              "band"
            ],
            "properties": {
              "identityPattern": {
                "type": "string"
              },
              "band": {
                "type": "string",
                "enum": [
                  "hot",
                  "warm",
                  "cold"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "runInvariants": {
      "type": "object",
      "required": [
        "maxIterations",
        "quiescenceThreshold",
        "determinismMode"
      ],
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1
        },
        "quiescenceThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "determinismMode": {
          "type": "string",
          "enum": [
            "strict",
            "lenient"
          ]
        },
        "completionPredicate": {
          "type": "string",
          "description": "Optional 'satisfactory solution' stop criterion. Fully-qualified Java class name implementing the engine's CompletionPredicate interface. Frozen from RunConfig."
        }
      },
      "additionalProperties": false
    },
    "resolverOverrides": {
      "type": "object",
      "description": "Per-panel resolver overrides keyed by panel name.",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "highestConfidence",
          "firstWriter",
          "failOnConflict",
          "collectAll",
          "compose"
        ]
      }
    },
    "granularityPolicy": {
      "type": "object",
      "additionalProperties": true,
      "description": "Frozen from RunConfig.granularityPolicy. Pack-typed payload accessed by Target-Blackboard `GranularityKS` (TOP_DOWN) via `controlContext.runContext().granularityPolicy()` to drive `Definition.Verdict` postings (`keep` / `drop` / `splitInto` / `mergeWith`). Wave 9: replaces the dropped Granularity panel's per-Run policy levers."
    },
    "externalToolBindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "resolvedPath",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "resolvedPath": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
