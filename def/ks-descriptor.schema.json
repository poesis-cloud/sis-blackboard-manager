{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://gsm-sourcer/ks-descriptor/v1",
  "title": "KnowledgeSourceDescriptor",
  "description": "Descriptor for a Knowledge Source (KS). KSs are Pack-shipped sandboxed Java JARs. KSs are unaware of each other; ordering is data-driven via triggerPredicate over Blackboard state. No `dependsOn` between KSs.",
  "type": "object",
  "required": [
    "id",
    "family",
    "writesPanel",
    "triggerPredicate",
    "determinismDefault"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Versioned gsmarc:// URI."
    },
    "family": {
      "type": "string",
      "enum": [
        "DiscoveryKS",
        "RelationKS",
        "InterfaceKS",
        "IdentificationKS",
        "ReconciliationKS",
        "ArchetypeKS",
        "StatementShapingKS",
        "GranularityKS",
        "EvidenceCollectionKS",
        "ConfidenceSynthesisKS"
      ]
    },
    "writesPanel": {
      "type": "string",
      "enum": [
        "SourceInventory",
        "SourceUnit",
        "SourceRelation",
        "SourceInterface",
        "Definition",
        "Archetype",
        "Statement",
        "Granularity",
        "Evidence",
        "Confidence"
      ]
    },
    "writesSlots": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Slots within writesPanel that this KS may post (subset of the panel's closed slot set)."
    },
    "readsPanels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SourceInventory",
          "SourceUnit",
          "SourceRelation",
          "SourceInterface",
          "Definition",
          "Archetype",
          "Statement",
          "Granularity",
          "Evidence",
          "Confidence"
        ]
      },
      "description": "Panels this KS reads (must be subset of dependsOnPanels* of writesPanel in the panel DAG)."
    },
    "triggerPredicate": {
      "type": "string",
      "description": "Tiny declarative DSL over Blackboard state. Operators: ==, &&, ||, !, .size. Predicates: panel == <Panel>, slot == <Slot>, resolved(<Panel>, identity), contributedBy(self, identity), evidence(identity).size > N, runContext.scope.includes(identity)."
    },
    "appliesToInterpretationKinds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional fast-pruning hint over slot names of read panels."
    },
    "parallelSafe": {
      "type": "boolean",
      "default": true
    },
    "determinismDefault": {
      "type": "string",
      "enum": [
        "DETERMINISTIC",
        "NON_DETERMINISTIC"
      ]
    },
    "resolverHint": {
      "type": "string",
      "enum": [
        "highestConfidence",
        "firstWriter",
        "failOnConflict",
        "userMediated",
        "collectAll"
      ],
      "description": "Recommended ContributionResolver for the writesPanel; RunConfig may override."
    },
    "inferenceServiceNeeded": {
      "type": "boolean",
      "default": false
    },
    "defmanExplorationNeeded": {
      "type": "boolean",
      "default": false
    },
    "defmanReadScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "externalTools": {
      "type": "array",
      "description": "Whitelisted external binaries this KS will execve via ControlContext.tool(name). Engine enforces: tool must be (a) declared here AND (b) bound in RunConfig.externalToolBindings.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "versionSpec"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "versionSpec": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "wallClockMs": {
          "type": "integer",
          "minimum": 1
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 1
        },
        "inferenceTokens": {
          "type": "integer",
          "minimum": 0
        },
        "defmanCalls": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
