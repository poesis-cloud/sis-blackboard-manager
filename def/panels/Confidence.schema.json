{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://gsm-sourcer/panels/Confidence/v1",
  "title": "ConfidenceValue",
  "description": "Value posted onto the Confidence panel (engine-owned, GSM-spine): synthesized confidence score for a target panel decision.",
  "type": "object",
  "required": [
    "slot",
    "targetIdentityKey",
    "targetPanel",
    "score",
    "method"
  ],
  "properties": {
    "slot": {
      "type": "string",
      "enum": [
        "Score"
      ]
    },
    "targetIdentityKey": {
      "type": "string"
    },
    "targetPanel": {
      "type": "string",
      "enum": [
        "Definition",
        "Archetype",
        "Statement",
        "Granularity"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "method": {
      "type": "string"
    },
    "supportingEvidenceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
