{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://gsm-sourcer/panels/Statement/v1",
  "title": "StatementValue",
  "description": "Value posted onto the Statement panel (engine-owned, GSM-spine): populated GSM statement payload conforming to the resolved archetype JSON Schema.",
  "type": "object",
  "required": [
    "slot",
    "targetIdentityKey",
    "statement",
    "completeness",
    "shapingMethod"
  ],
  "properties": {
    "slot": {
      "type": "string",
      "enum": [
        "Draft"
      ]
    },
    "targetIdentityKey": {
      "type": "string"
    },
    "statement": {
      "type": "object",
      "additionalProperties": true
    },
    "completeness": {
      "type": "string",
      "enum": [
        "partial",
        "full"
      ]
    },
    "shapingMethod": {
      "type": "string",
      "description": "Identifier of the shaping method (e.g. structural-extraction, llm-behavioral-lift)."
    }
  },
  "additionalProperties": false
}
