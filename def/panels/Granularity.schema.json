{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://gsm-sourcer/panels/Granularity/v1",
  "title": "GranularityValue",
  "description": "Value posted onto the Granularity panel (engine-owned, GSM-spine): consolidation verdict per Definition.",
  "type": "object",
  "required": [
    "slot",
    "targetIdentityKey",
    "verdict"
  ],
  "properties": {
    "slot": {
      "type": "string",
      "enum": [
        "Verdict"
      ]
    },
    "targetIdentityKey": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "keep",
        "drop",
        "splitInto",
        "mergeWith"
      ]
    },
    "targetIdentityKeys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required for splitInto / mergeWith verdicts."
    },
    "rationale": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
