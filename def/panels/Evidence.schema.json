{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://gsm-sourcer/panels/Evidence/v1",
  "title": "EvidenceValue",
  "description": "Value posted onto the Evidence panel (engine-owned, GSM-spine): additive corroboration per Definition. Resolver default = collectAll.",
  "type": "object",
  "required": [
    "slot",
    "targetIdentityKey",
    "source",
    "signal",
    "weight"
  ],
  "properties": {
    "slot": {
      "type": "string",
      "enum": [
        "Signal"
      ]
    },
    "targetIdentityKey": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "description": "Source of the signal (e.g. test-presence, reachability, doc-presence, deployment)."
    },
    "signal": {
      "type": "string",
      "description": "Free-form signal name."
    },
    "weight": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "supportingSourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
