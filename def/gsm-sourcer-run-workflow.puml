@startuml gsm-sourcer-run-workflow

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #57606A
  LifeLineBorderColor #57606A
  GroupBackgroundColor #F6F8FA
  GroupBorderColor #57606A
}
skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

title GSM Sourcer - End-to-end Run workflow

actor "Run Operator" as Op
actor "Reviewer" as Rev

participant "Sourcer API" as API
participant "Initializer" as Init
participant "Plug-in Loader" as PL
participant "Instructions\nProvider (Pack)" as IP
participant "Scope/Focus\nBuilders" as SF
participant "SourcingRunContext\n(immutable per Run;\nengine run state)" as RC
participant "Control" as Ctrl
participant "Blackboard\n(panels)" as BB
participant "Resolver" as Res
participant "Sandboxed KSs" as KSs
participant "External Tools\n(allowlisted)" as ExtT
participant "InferenceService" as Inf
participant "DefManExploration" as DefExp
participant "Pipeline" as Pipe
participant "JsonSchemaValidator" as JV
participant "DefManClient" as DM
participant "BundleStore" as BS
participant "RunLedger" as RL

== Initialization (canonical step) ==

Op -> API : POST /runs RunConfig\n{sourcingPacks[], profile,\n instructionsPayload,\n externalToolBindings,\n resolverOverrides, runInvariants,\n checkpoints}
API -> Init : startRun(runId, runConfig)

group Initializer substeps
  Init -> PL : load Packs (sandboxed classloaders)
  Init -> IP : provide(InstructionsContext{runConfig.instructionsPayload})
  IP -> BS : (optional) write source artefacts\n(e.g. clone repo, snapshot)
  IP --> Init : InstructionsResult{instructionsPayload, profile}
  Init -> SF : buildScope(profile) ; buildFocus(scope, runConfig)
  SF --> Init : scope, focus
  Init -> RC : freeze(SourcingRunContext)
  Init -> BB : Blackboard Builder substep\n(declare engine target spine\n + Pack source-side panels from manifest;\n validate panel DAG;\n instantiate empty panels)
end

Init -> RL : record Run START

== Checkpoint-0 (governance overlay; optional, post-Initialization) ==

alt runConfig.checkpoints.0 = true
  Init -> RL : record CHECKPOINT_0_PENDING
  Rev -> API : GET /runs/{id}/runContext
  Rev -> API : POST /runs/{id}/checkpoint-0/{approve|reject}
  alt rejected
    API -> Ctrl : abort
  end
end

== Activation + Execution + Conflict Resolution + Iteration (canonical loop) ==

loop until quiescence OR maxIterations OR completionPredicate

  ' --- Activation: Control selects eligible KSs based on current Blackboard state ---
  Ctrl -> BB : query state
  Ctrl -> Ctrl : Activation:\n  enumerate eligible KSs\n  (triggerPredicate true)

  ' --- Execution: activated KSs read inputs and post Contributions ---
  Ctrl -> KSs : Execution:\n  fire eligible KSs\n  (parallelSafe in parallel)

  alt DiscoveryKS fires
    KSs -> ExtT : execve scip-* / syft / tokei (sandboxed)
    ExtT --> KSs : output -> BundleStore
    KSs -> BB : post Contribution(panel=SourceInventory|SourceUnit, slot=...)
  else RelationKS fires
    KSs -> ExtT : joern-parse / scip relationships
    KSs -> BB : post Contribution(panel=SourceRelation, slot=CallEdge|...)
  else InterfaceKS fires
    KSs -> BB : post Contribution(panel=SourceInterface, slot=OpenApiOperation|...)
  else IdentificationKS fires
    KSs -> BB : query SourceInterface / SourceUnit
    KSs -> RC : runContext().scope.includes(...)
    KSs -> BB : post Contribution(panel=Definition, slot=Claim,\n  value={subjectKind, identityKey, supportingSourceIds})
  else ReconciliationKS fires
    KSs -> BB : post Contribution(panel=Definition, slot=Merge,\n  supersedesIdentityKeys=[...])
  else ArchetypeKS fires
    KSs -> BB : resolved(Definition, identity)
    KSs -> DefExp : (optional) navigate
    KSs -> BB : post Contribution(panel=Archetype, slot=Application,\n  value={archetypeRef})
  else StatementShapingKS fires
    KSs -> BB : resolved(Archetype, identity)
    alt LLM-driven
      KSs -> Inf : completeStatement(identity)\n  withTools({DEFMAN_EXPLORATION})
      Inf --> KSs : InferenceResult\n  (NON_DETERMINISTIC + cacheKey)
    else deterministic
      KSs -> KSs : structural extraction
    end
    KSs -> JV : incremental schema check
    KSs -> BB : post Contribution(panel=Statement, slot=Draft)
  else GranularityKS fires
    KSs -> BB : resolved(Statement, identity) + peers
    KSs -> BB : post Contribution(panel=Granularity, slot=Verdict)
  else EvidenceCollectionKS fires
    KSs -> BB : post Contribution(panel=Evidence, slot=Signal)
  else ConfidenceSynthesisKS fires
    KSs -> BB : evidence + diagnostics
    KSs -> BB : post Contribution(panel=Confidence, slot=Score)
  end

  ' --- Conflict Resolution: per-panel ContributionResolver reconciles competing contributions ---
  Ctrl -> Res : Conflict Resolution:\n  reconcile per-panel
  Res -> BB : update resolved view

  ' --- Iteration: loop continues until quiescence or maxIterations ---
end

== Checkpoint-A (governance overlay; optional) ==

Ctrl -> BS : snapshot Blackboard (Stage-A)
Ctrl -> RL : record CHECKPOINT_A_PENDING
Rev -> API : GET /runs/{id}/blackboard
API --> Rev : Stage-A snapshot
alt approve | override | reject
  Rev -> API : decision
  API -> Ctrl : apply (override -> Override Cascader)
end

== Pipeline: Validation (engine-only) ==

loop for each Definition (with Granularity != drop)
  Ctrl -> Pipe : validate(identity)
  Pipe -> JV : validate(resolved Statement, archetype schema)
  alt OK
    Pipe -> Pipe : produce ValidatedAscriptionDraft
  else failed
    Pipe -> BB : post Diagnostic
    Pipe -> KSs : re-fire upstream (capped retries)
  end
end

== Checkpoint-B (governance overlay) ==

Ctrl -> BS : snapshot Pipeline state (Stage-B)
Rev -> API : approve | override | reject

== Pipeline: Registration (engine-only) ==

loop for each approved ValidatedAscriptionDraft
  Pipe -> DM : POST /ascriptions DRAFT
  DM --> Pipe : AscriptionUri
  Pipe -> Pipe : record RegisteredAscription
end

== Run end ==

Ctrl -> BS : final snapshot
Ctrl -> RL : record Run END
API --> Op : RunResult{registeredCount, diagnostics, bundleRef, ledgerRef}

@enduml
