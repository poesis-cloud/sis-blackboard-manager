@startuml gsm-sourcer-run-workflow

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #57606A
  ParticipantFontColor #24292F
  ActorBackgroundColor #FFFFFF
  ActorBorderColor #57606A
  LifeLineBorderColor #57606A
  GroupBackgroundColor #F6F8FA
  GroupBorderColor #57606A
}

skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

title GSM Sourcer - End-to-end Run workflow (Blackboard convergence + Pipeline)

actor "Run Operator" as Op
actor "Reviewer" as Rev

participant "Run Control" as RC
participant "Plug-in Resolver" as PR
participant "Control" as Ctrl
participant "Blackboard\n(panels)" as BB
participant "Resolver\n(per-panel)" as Res
participant "Sandboxed KSs\n(per Pack)" as KSs
participant "InferenceService" as Inf
participant "DefManExploration" as DefExp
participant "ArchetypeResolver" as AR
participant "Pipeline" as Pipe
participant "JsonSchemaValidator" as JV
participant "DefManClient" as DM
participant "BundleStore" as BS
participant "RunLedger" as RL

== Run start ==

Op -> RC : POST /runs RunRequest\n{sourceContext, packs[], profile,\n targetCatalogues[], contributionResolvers}
RC -> PR : resolve packs (URIs+versions)
PR -> RC : KS classloaders ready
RC -> Ctrl : startRun(runId, config)
Ctrl -> RL : record Run START
Ctrl -> BB : open empty Blackboard\n(7 panels)
Ctrl -> BS : snapshot(sourceContext)
BS -> Ctrl : SourceContextSnapshot

== Blackboard convergence loop (data-driven, KSs unaware of each other) ==

loop until quiescence OR maxIterations reached

  Ctrl -> Ctrl : enumerate eligible KSs\n(triggerPredicate true vs current Blackboard state)
  Ctrl -> KSs : fire eligible KSs\n(parallelSafe ones in parallel)

  alt DiscoveryKS fires
    KSs -> BB : post Contribution(panel=SourceInterpretation,\n  value=SourceInterpretationValue{kind, payload, signals})
  else IdentificationKS fires
    KSs -> BB : query SourceInterpretations
    KSs -> BB : post Contribution(panel=SubjectIdentity,\n  value={subjectKind, identityKey, interpretsIds})
    note over Ctrl, BB
      Axis-1 intake filter (Functional / Reachability / ...)
      runs HERE as a Control admission policy on
      SubjectIdentity contributions.
    end note
  else ReconciliationKS fires
    KSs -> BB : query SubjectIdentity contributions
    KSs -> BB : post merging SubjectIdentity contribution
  else ArchetypingKS fires
    KSs -> BB : resolved(SubjectIdentity, identity)
    KSs -> DefExp : (optional) navigateFrom siblings
    DefExp --> KSs : ExplorationResult
    KSs -> BB : post Contribution(panel=Archetyping,\n  value={archetypeRef, rationale})
  else StatementShapingKS fires
    KSs -> BB : resolved(Archetyping, identity)
    Ctrl -> AR : resolveSchema(archetypeRefs)
    AR --> Ctrl : ResolvedJsonSchema
    alt LLM-driven shaping
      KSs -> Inf : completeStatement(identity)\n  withTools({DEFMAN_EXPLORATION})
      loop function-calling
        Inf -> DefExp : tool call (LLM-issued)
        DefExp --> Inf : result (per-Run cache)
      end
      Inf --> KSs : InferenceResult\n  (NON_DETERMINISTIC + cacheKey)
    else deterministic shaping
      KSs -> KSs : structural extraction
    end
    KSs -> JV : incremental validation\n  (partial statement vs schema)
    JV --> KSs : OK | failures
    KSs -> BB : post Contribution(panel=Statement,\n  value={statement, completeness, shapingMethod})
  else GranularityKS fires
    KSs -> BB : resolved(Statement, identity) +\n peers in same Structure
    KSs -> BB : post Contribution(panel=Granularity,\n  value={verdict, targetIdentityKeys})
  else EvidenceCollectionKS fires
    KSs -> BB : resolved(Statement, identity)
    KSs -> BB : post Contribution(panel=Evidence,\n  value={source, signal, weight})
  else ConfidenceSynthesisKS fires
    KSs -> BB : evidence + diagnostics
    KSs -> BB : post Contribution(panel=Confidence,\n  value={targetPanel, score, method})
  end

  Ctrl -> Res : resolve panels affected
  Res -> BB : update resolved view

end

note over Ctrl
  Quiescence = N consecutive iterations with zero
  new Contributions (configurable). The loop is
  data-driven; ordering between KSs is emergent
  from triggerPredicates over Blackboard state.
end note

== Checkpoint-A (governance overlay) ==

Ctrl -> BS : snapshot Blackboard (Stage-A)
Ctrl -> RL : record CHECKPOINT_A_PENDING
Rev -> RC : GET /runs/{id}/blackboard
RC --> Rev : Stage-A snapshot (resolved + competing contributions)

alt approve
  Rev -> RC : approve all
  RC -> Ctrl : resume
else override
  Rev -> RC : POST override on (panel, identity, slot)
  RC -> Ctrl : append user Contribution (supersedes prior winner)
  Ctrl -> BB : post + invalidate dependent resolved values
  Ctrl -> KSs : re-fire affected triggers (cascade -> back to convergence loop)
else reject
  Rev -> RC : drop SubjectIdentity
  RC -> Ctrl : remove identity + dependent contributions
end

== Pipeline: Validation stage (engine-only) ==

loop for each approved SubjectIdentity
  Ctrl -> Pipe : validate(identity)
  Pipe -> AR : resolveSchema(resolved Archetyping)
  Pipe -> JV : validate(resolved Statement, schema)
  alt OK
    Pipe -> Pipe : produce ValidatedAscriptionDraft
  else failed
    Pipe -> BB : post Diagnostic
    Pipe -> KSs : re-fire StatementShapingKSs (capped retries -> back to convergence)
  end
end

== Checkpoint-B (governance overlay) ==

Ctrl -> BS : snapshot Pipeline state (Stage-B)
Ctrl -> RL : record CHECKPOINT_B_PENDING
Rev -> RC : approve | override | reject (same protocol as Checkpoint-A)

== Pipeline: Registration stage (engine-only) ==

loop for each Checkpoint-B-approved ValidatedAscriptionDraft
  Pipe -> DM : POST /ascriptions DRAFT
  DM --> Pipe : AscriptionUri
  Pipe -> Pipe : record RegisteredAscription
end

== Run end ==

Ctrl -> BS : final Blackboard + Pipeline snapshot
Ctrl -> RL : record Run END (success | partial | failed)
RC --> Op : RunResult\n{registeredCount, diagnostics, bundleRef, ledgerRef}

@enduml
