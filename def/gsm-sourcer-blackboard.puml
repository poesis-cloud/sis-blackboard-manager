@startuml gsm-sourcer-blackboard

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #57606A
  FontColor #24292F
}
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F8FA
skinparam packageBorderColor #57606A
skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

frame "CD - GSM Sourcer - Blackboard panel topology" {

  package "Source Panels Group (Pack-owned)" as SRC {
    class SourceInventory <<panel>> {
      slots:
      FileTreeNode
      GitCommit
      ModuleSpec
      LanguageClassification
      FileMetrics
      SbomComponent
      ConfigEntry
    }
    class SourceUnit <<panel>> {
      slots:
      CodeUnit          (SCIP SymbolInformation)
      JpaEntity
      ProtoMessage
      GraphqlSchema
      IacResource
    }
    class SourceRelation <<panel>> {
      slots:
      SymbolRef         (from SCIP occurrences)
      TypeHierarchyEdge (from SCIP relationships)
      ImplementationEdge
      ImportEdge
      CallEdge          (from Joern CPG)
      DataflowEdge      (from Joern CPG)
      DeploymentEdge
    }
    class SourceInterface <<panel>> {
      slots:
      OpenApiOperation
      KafkaTopic
      DbTable
      TestSpec
    }
  }

  package "Target Panels Group (engine-owned, GSM spine)" as TGT {
    class Definition <<panel>> {
      slots:
      Claim   (IdentificationKS)
      Merge   (ReconciliationKS)
      ----
      keyed by identityKey
      subjectKind in
      {Structure, Mechanism, Effector,
       Receptor, Interaction, Archetype,
       Directive, Norm}
    }
    class Archetype <<panel>> {
      slots:
      Application
      ----
      one ArchetypeRef per contribution
      panel-effective value =
      union over Applications
    }
    class Statement <<panel>> {
      slots:
      Draft
      ----
      validated against the
      resolved archetype JSON Schema
    }
    class Granularity <<panel>> {
      slots:
      Verdict
      ----
      verdict in {keep, drop,
                  splitInto, mergeWith}
    }
    class Evidence <<panel>> {
      slots:
      Signal
      ----
      additive; weight in [-1,1]
      resolver = collectAll
    }
    class Confidence <<panel>> {
      slots:
      Score
      ----
      targetPanel in
      {Definition, Archetype,
       Statement, Granularity}
    }
  }

  ' Panel DAG (Pack-owned source side + bridge + engine-owned target side)
  SourceInventory --> SourceUnit
  SourceUnit --> SourceInterface
  SourceUnit --> SourceRelation
  SourceInterface --> Definition : <<bridge>>
  SourceUnit --> Definition : <<bridge>>
  SourceRelation --> Definition : <<bridge>>
  Definition --> Archetype
  Archetype --> Statement
  Statement --> Granularity
  Statement --> Evidence
  Evidence --> Confidence

  package "Off-Blackboard" as OBB <<Frame>> {
    class SourcingRunContext <<immutable>> {
      runId
      profile
      instructionsPayload
      scope { inclusion, exclusion, axisDecision }
      focus { priorityBands }
      runInvariants { maxIterations,
                      quiescenceThreshold,
                      determinismMode }
      resolverOverrides
      externalToolBindings
      ----
      built by Initializer in
      3 substeps; frozen for the Run;
      read by all KSs via
      controlContext.runContext()
    }
  }

  note bottom of SRC
    Pack-owned topology. Slot sets are CLOSED at Pack
    registration (one slot = one contribution-type =
    one panel property). Panel value schema is owned
    by the Pack.
  end note

  note bottom of TGT
    Engine-owned topology (GSM spine). Closed slot
    sets, frozen value schemas. The Pipeline consumes
    the converged target tuple; Pipeline records
    (ValidatedAscriptionDraft, RegisteredAscription)
    are NOT panels.
  end note
}

@enduml
