  ' RELATIONSHIPS
  ' ============================================================

  ' DIP hierarchy
  SourceAnalysisPanel --|> Panel
  TargetDefinitionPanel --|> Panel
  Definition --|> TargetDefinitionPanel
  Archetype --|> TargetDefinitionPanel
