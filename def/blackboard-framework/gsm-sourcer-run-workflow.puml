@startuml gsm-sourcer-run-workflow

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #57606A
  LifeLineBorderColor #57606A
  GroupBackgroundColor #F6F8FA
  GroupBorderColor #57606A
}
skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

title GSM Sourcer - End-to-end Run workflow

actor "Run Operator" as Op

participant "Sourcer API" as API
participant "Initializer" as Init
participant "Plug-in Loader" as PL
participant "Instructions\nProvider (Pack)" as IP
participant "Scope/Focus\nBuilders" as SF
participant "SourcingRunContext\n(immutable per Run;\nengine run state)" as RC
participant "SourceController" as SCtrl
participant "TargetController" as TCtrl
participant "SourceBlackboard" as SBB
participant "TargetBlackboard" as TBB
participant "BlackboardResolution\n(immutable bridge)" as SF
participant "Resolver" as Res
participant "Sandboxed KSs" as KSs
participant "External Tools\n(allowlisted)" as ExtT
participant "InferenceService" as Inf
participant "DefManExploration" as DefExp
participant "Pipeline" as Pipe
participant "JsonSchemaValidator" as JV
participant "DefManClient" as DM
participant "BundleStore" as BS
participant "RunLedger" as RL

== Initialization (canonical step) ==

Op -> API : POST /runs RunConfig\n{sourcingPacks[], profile,\n instructionsPayload,\n externalToolBindings,\n resolverOverrides, runInvariants}
API -> Init : startRun(runId, runConfig)

group Initializer substeps
  Init -> PL : load Packs (sandboxed classloaders)
  Init -> IP : provide(InstructionsContext{runConfig.instructionsPayload})
  IP -> BS : (optional) write source artefacts\n(e.g. clone repo, snapshot)
  IP --> Init : InstructionsResult{instructionsPayload, profile}
  Init -> SF : buildScope(profile) ; buildFocus(scope, runConfig)
  SF --> Init : scope, focus
  Init -> RC : freeze(SourcingRunContext)
  Init -> SBB : Source Blackboard Builder\n(Pack panels;\nvalidate Source DAG; instantiate)
  Init -> TBB : Target Blackboard Builder\n(engine 3-panel spine:\nDefinition, Archetype, Statement;\nvalidate Target DAG; instantiate)
end

Init -> RL : record Run START

== Source phase: Activation + Execution + Conflict Resolution + Iteration ==

loop until Source quiescence OR maxIterations OR completionPredicate

  SCtrl -> SBB : query state
  SCtrl -> SCtrl : Activation:\n  enumerate eligible Source KSs\n  (targetBlackboard = source;\n   triggerPredicate true)

  SCtrl -> KSs : Execution: fire eligible Source KSs\n  (parallelSafe in parallel)

  alt DiscoveryKS fires
    KSs -> ExtT : execve scip-* / syft / tokei (sandboxed)
    ExtT --> KSs : output -> BundleStore
    KSs -> SBB : post Contribution(panel=<Pack:SourceInventory|SourceUnit>, slot=...)
  else RelationKS fires
    KSs -> ExtT : joern-parse / scip relationships
    KSs -> SBB : post Contribution(panel=<Pack:SourceRelation>, slot=CallEdge|...)
  else InterfaceKS fires
    KSs -> SBB : post Contribution(panel=<Pack:SourceInterface>, slot=OpenApiOperation|...)
  end

  SCtrl -> Res : Conflict Resolution: reconcile per (panel, slot)
  Res -> SBB : update resolved view
end

== Sequential bridge: Source Resolution ==

SCtrl -> SF : sourceResolution = snapshot(SourceBlackboard)\n  (deep-immutable snapshot:\n   panels, slots, contributions)
SCtrl -> RL : record Source phase END
SF --> TCtrl : start Target phase

== Target phase: Activation + Execution + Conflict Resolution + Iteration ==

loop until Target quiescence OR maxIterations OR completionPredicate

  TCtrl -> TBB : query state
  TCtrl -> TCtrl : Activation:\n  enumerate eligible Target KSs\n  (targetBlackboard = target;\n   triggerPredicate true)

  TCtrl -> KSs : Execution: fire eligible Target KSs

  alt IdentificationKS fires
    KSs -> SF : sourceResolution.has(<Pack:SourceUnit>, identity)
    KSs -> RC : runContext().scope.includes(...)
    KSs -> TBB : post Contribution(panel=Definition, slot=Claim,\n  value={subjectKind, identityKey, supportingSourceIds})
  else ReconciliationKS fires
    KSs -> TBB : post Contribution(panel=Definition, slot=Merge,\n  supersedesIdentityKeys=[...])
  else ArchetypeKS fires
    KSs -> TBB : resolved(Definition, identity)
    KSs -> DefExp : (optional) navigate
    KSs -> TBB : post Contribution(panel=Archetype, slot=Application,\n  value={archetypeRef})
  else StatementShapingKS fires
    KSs -> TBB : resolved(Archetype, identity)
    alt LLM-driven
      KSs -> Inf : completeStatement(identity)\n  withTools({DEFMAN_EXPLORATION})
      Inf --> KSs : InferenceResult\n  (NON_DETERMINISTIC + cacheKey)
    else deterministic
      KSs -> KSs : structural extraction
    end
    KSs -> JV : incremental schema check
    KSs -> TBB : post Contribution(panel=Statement, slot=Draft,\n  evidence=[EvidenceRef...])
  else GranularityKS fires (TOP_DOWN)
    KSs -> TBB : resolved(Statement, identity) + peers
    KSs -> TBB : post Contribution(panel=Definition, slot=Verdict,\n  value={verdict: keep|drop|splitInto|mergeWith, ...})
  else ConfidenceSynthesisKS fires
    KSs -> TBB : contributionsOf(Statement, identity)
    KSs -> TBB : post refined Contribution(panel=Statement, slot=Draft,\n  with synthesised confidence + evidence)
  end

  TCtrl -> Res : Conflict Resolution: reconcile per (panel, slot)
  Res -> TBB : update resolved view
end

== Sequential bridge: Target Resolution ==

TCtrl -> SF : targetResolution = snapshot(TargetBlackboard)\n  (deep-immutable snapshot:\n   panels, slots, contributions)
SF --> Pipe : start Pipeline (consumes targetResolution)

== Pipeline: Validation (engine-only) ==

loop for each Definition (with Definition.Verdict != drop)
  TCtrl -> Pipe : validate(identity)
  Pipe -> JV : validate(resolved Statement, archetype schema)
  alt OK
    Pipe -> Pipe : produce ValidatedAscriptionDraft
  else failed
    Pipe -> TBB : post Diagnostic
    Pipe -> KSs : re-fire upstream (capped retries)
  end
end

== Pipeline: Registration (engine-only) ==

loop for each approved ValidatedAscriptionDraft
  Pipe -> DM : POST /ascriptions DRAFT
  DM --> Pipe : AscriptionUri
  Pipe -> Pipe : record RegisteredAscription
end

== Run end ==

TCtrl -> BS : final snapshot
TCtrl -> RL : record Run END
API --> Op : RunResult{registeredCount, diagnostics, bundleRef, ledgerRef}

@enduml
