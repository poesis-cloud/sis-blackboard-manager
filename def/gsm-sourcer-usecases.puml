@startuml gsm-sourcer-usecases

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #57606A
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #57606A
}
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F8FA
skinparam packageBorderColor #57606A
skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

frame "UC - GSM Sourcer" {

  actor "Run Operator" as Op
  actor "Reviewer\n(checkpoint)" as Rev
  actor "KS Author\n(Sourcing Pack)" as Author
  actor "Auditor /\nCompliance" as Aud
  actor "DefMan\n(downstream)" as DM
  actor "LLM Provider\n(external)" as LLM

  package "Run lifecycle" {
    usecase "Submit Run\n(sourceContext + packs +\nprofile + targetCatalogues)" as UC_Submit
    usecase "Monitor Run progress" as UC_Monitor
    usecase "Inspect Blackboard at\nCheckpoint-A / Checkpoint-B" as UC_Inspect
    usecase "Approve / Override / Reject\nat Checkpoint" as UC_Decide
    usecase "Cancel Run" as UC_Cancel
  }

  package "Audit & replay" {
    usecase "Snapshot replay\n(view past Blackboard)" as UC_Snap
    usecase "Re-derivation replay\n(with cached inference)" as UC_Rederiv
    usecase "Drift detection\n(re-source same input)" as UC_Drift
    usecase "Trace contribution\n(provenance / contributors)" as UC_Trace
  }

  package "Pack management" {
    usecase "Author KS / Sourcing Pack" as UC_Author
    usecase "Declare KS descriptor\n(deps, trigger, budgets)" as UC_Declare
    usecase "Publish Sourcing Pack\n(versioned URI)" as UC_Publish
    usecase "Approve Pack\n(R6 end-state: as Definition)" as UC_Approve
  }

  package "DRAFT submission" {
    usecase "Register DRAFT Ascriptions\n(engine-only)" as UC_Register
  }

  Op --> UC_Submit
  Op --> UC_Monitor
  Op --> UC_Cancel
  Rev --> UC_Inspect
  Rev --> UC_Decide

  Aud --> UC_Snap
  Aud --> UC_Trace
  Aud --> UC_Rederiv
  Aud --> UC_Drift

  Author --> UC_Author
  Author --> UC_Declare
  Author --> UC_Publish
  Author --> UC_Approve

  UC_Submit ..> UC_Register : <<include>>
  UC_Register --> DM
  UC_Submit ..> LLM : optional\n(via InferenceService)

  note right of UC_Author
    KS = Java JAR. No DSL for logic.
    Trigger predicate is a tiny declarative DSL.
    Network egress denied at pack-classloader scope.
    LLM and DefMan only via ControlContext.
  end note

  note right of UC_Snap
    Snapshot replay is the PRIMARY guarantee
    (always available; non-determinism doesn't
    break it because the past Blackboard is stored).

    Re-derivation is best-effort with the per-Run
    inference cache.
  end note
}

@enduml
