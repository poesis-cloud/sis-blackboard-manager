@startuml gsm-sourcer-ks-contract

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F8FA
skinparam packageBorderColor #57606A

skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #57606A
skinparam classFontColor #24292F

skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

frame "CD - GSM Sourcer - Knowledge Source contract" {

  note as ContractNote
    **Knowledge Source (KS)** = a Java JAR shipped inside a Sourcing Pack.

    A KS posts Contributions to ONE Blackboard panel.

    **Canonical Blackboard rules enforced by the engine:**
    - KSs are unaware of each other. There is NO `dependsOn` between
      KSs. Ordering is expressed exclusively through `triggerPredicate`
      over Blackboard state.
    - KSs NEVER call DefMan, LLM providers, network or filesystem
      outside `ControlContext`.
    - KSs NEVER mutate posted Contributions (append-only).
    - The Pipeline (Validation, Registration) is engine-only; no KS
      contributes to it.

    **Validation Rules:**
    - `id` MUST be a versioned `gsmarc://` URI (no implicit "latest").
    - `writesPanel` MUST be one panel.
    - For every read panel r in `readsPanels`: dependency is on
      Blackboard STATE, not on a specific KS.
    - Trigger predicate language is restricted to read-only structural
      checks. No side effects, no method calls.
  end note

  package "Knowledge Source" {

    interface KnowledgeSource {
      +descriptor() : KnowledgeSourceDescriptor
      +contribute(trigger : Trigger, view : BlackboardView, ctx : ControlContext) : List<Contribution>
    }

    class KnowledgeSourceDescriptor <<descriptor>> {
      +id : KnowledgeSourceId
      +family : KnowledgeSourceFamily
      +writesPanel : Panel
      +writesSlots : Set<SlotName>
      +readsPanels : Set<Panel>
      +triggerPredicate : TriggerPredicate
      +appliesToInterpretationKinds : Set<InterpretationKind>
      +parallelSafe : Boolean
      +determinismDefault : Determinism
      +resolverHint : ContributionResolver?
      +defmanExplorationNeeded : Boolean
      +defmanReadScope : Set<ArchetypeUri>
      +inferenceServiceNeeded : Boolean
      +budget : ResourceBudget
    }
    note right of KnowledgeSourceDescriptor
      **No `dependsOn`.** Coupling between KSs is forbidden.
      A KS that needs another KS's output reads the resulting
      Blackboard state via `triggerPredicate` and `readsPanels`.

      `resolverHint` is advisory. Effective resolver per panel:
        RunConfig.contributionResolvers[panel] (override)
        > KS.resolverHint
        > engine default for that panel
    end note

    enum KnowledgeSourceFamily {
      DiscoveryKS
      IdentificationKS
      ArchetypingKS
      StatementShapingKS
      ReconciliationKS
      GranularityKS
      EvidenceCollectionKS
      ConfidenceSynthesisKS
    }

    enum Panel {
      SourceInterpretation
      SubjectIdentity
      Archetyping
      Statement
      Granularity
      Evidence
      Confidence
    }

    class TriggerPredicate <<DSL>> {
      +expression : String
    }
    note right of TriggerPredicate
      **Tiny declarative DSL** evaluated by Control over Blackboard
      state. Read-only, no side effects, no method calls.

      Grammar (informal):
        expr     := and | or | not | atom
        atom     := panelEq | resolvedPredicate | contributedByPredicate
                  | interpretationKindIn | signalEquals | sizeCmp
        panelEq            := "panel" "==" Panel
        resolvedPredicate  := "resolved(" Panel ", identity )"
                            | "!resolved(" Panel ", identity )"
        contributedByPredicate := "contributedBy(self, identity )"
                                | "!contributedBy(self, identity )"
        interpretationKindIn := "kind in {" StringList "}"

      Examples:
        panel == SourceInterpretation
        panel == SubjectIdentity && !resolved(Archetyping, identity)
        panel == Archetyping && resolved(SubjectIdentity, identity)
                              && !contributedBy(self, identity)
        panel == Statement && resolved(Archetyping, identity)
                            && !contributedBy(self, identity)
        panel == Granularity && resolved(Statement, identity)
        panel == Confidence && resolved(Statement, identity)
                             && evidence(identity).size > 0
    end note

    enum Determinism {
      DETERMINISTIC
      NON_DETERMINISTIC
    }

    enum ContributionResolver {
      highestConfidence
      firstWriter
      failOnConflict
      userMediated
      collectAll
    }

    class ResourceBudget {
      +wallClockMs : Long
      +memoryMb : Integer
      +inferenceTokens : Long
      +inferenceCostUsd : Float
      +defmanCalls : Integer
    }

    KnowledgeSource ..> KnowledgeSourceDescriptor
    KnowledgeSourceDescriptor *-- KnowledgeSourceFamily
    KnowledgeSourceDescriptor *-- Panel : writesPanel
    KnowledgeSourceDescriptor *-- "0..*" Panel : readsPanels
    KnowledgeSourceDescriptor *-- TriggerPredicate
    KnowledgeSourceDescriptor *-- ResourceBudget
    KnowledgeSourceDescriptor o-- ContributionResolver : resolverHint
  }

  package "Engine surface (ControlContext)" {

    interface ControlContext {
      +runId() : RunId
      +runConfig() : RunConfig
      +blackboard() : BlackboardView
      +snapshot() : SnapshotService
      +archetypeResolver() : ArchetypeResolver
      +inference() : InferenceService
      +defmanExplore() : DefManExplorationService
      +schemaValidator() : JsonSchemaValidator
      +bundleStore() : BundleStoreView
      +diagnose(d : Diagnostic) : void
    }
    note right of ControlContext
      **Single API surface a KS sees.** Anything not on
      this interface is unreachable from a KS classloader.
    end note

    interface BlackboardView <<read-only for queries>> {
      +query(q : Query) : Stream<Contribution>
      +get(id : ContributionId) : Contribution?
      +resolved(panel : Panel, subjectIdentityId : SubjectIdentityId) : PanelValue?
      +contributionsOf(self : KnowledgeSourceId, identity : SubjectIdentityId) : Stream<Contribution>
      +post(panel : Panel, value : PanelValue, opts : PostOptions) : ContributionId
    }
    note right of BlackboardView
      `resolved(...)` returns the Control-resolved value
      (after running the configured ContributionResolver
      over all current contributions).

      `post(...)` is the only mutating operation.
      Engine attaches `contributorKsId`, `derivedFrom`,
      `createdAt`, and validates `cacheKey` presence
      when determinism = NON_DETERMINISTIC.
    end note

    interface DefManExplorationService <<read-only>> {
      +navigateFrom(root : AscriptionUri, follow : Set<RelType>, depth : Int) : ExplorationResult
      +searchByArchetype(a : ArchetypeUri, filter : Filter) : Page<AscriptionRef>
      +describeAscription(uri : AscriptionUri) : AscriptionView
    }

    interface InferenceService {
      +completeStatement(targetIdentity : SubjectIdentityId) : InferenceResult
      +withTools(tools : Set<EngineTool>) : InferenceSession
      +withPromptTemplate(t : PromptTemplate) : InferenceSession
    }
    note right of InferenceService
      Default prompt is engine-derived from the resolved
      Archetyping schema + supporting SourceInterpretations.
      A KS MAY override the prompt template.
      A KS MAY register `EngineTool.DEFMAN_EXPLORATION` so
      the LLM itself drives DefMan navigation via
      function-calling.
    end note

    enum EngineTool {
      DEFMAN_EXPLORATION
      JSON_SCHEMA_LOOKUP
      ARCHETYPE_RESOLUTION
    }

    ControlContext --> BlackboardView
    ControlContext --> DefManExplorationService
    ControlContext --> InferenceService
    InferenceService --> EngineTool : may use
  }

  KnowledgeSource ..> ControlContext : uses
}

@enduml
