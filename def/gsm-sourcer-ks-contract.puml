@startuml gsm-sourcer-ks-contract

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #57606A
  FontColor #24292F
}
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F8FA
skinparam packageBorderColor #57606A
skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

frame "CD - GSM Sourcer - Plug-in contracts (KS + Instructions Provider)" {

  interface KnowledgeSource {
    +List<Contribution> contribute(ControlContext ctx)
  }

  class KnowledgeSourceDescriptor <<descriptor>> {
    id : URI                         (gsmarc://...)
    family : enum                    (DiscoveryKS | RelationKS |
                                      InterfaceKS | IdentificationKS |
                                      ReconciliationKS | ArchetypeKS |
                                      StatementShapingKS | GranularityKS |
                                      ConfidenceSynthesisKS)
    targetBlackboard : enum          (source | target)
    direction : enum                 (BOTTOM_UP | TOP_DOWN; default BOTTOM_UP)
    writesPanel : String             (panel name; one; must belong to targetBlackboard)
    writesSlots : List<String>
    readsPanels : List<String>       (BOTTOM_UP: subset of dependsOnPanels*
                                      TOP_DOWN: may include descendants;
                                      sanctioned only for GranularityKS)
    triggerPredicate : Class<? extends KsTriggerPredicate>
                                     (FQN of a Java class)
    parallelSafe : boolean
    determinismDefault : enum        (DETERMINISTIC | NON_DETERMINISTIC)
    resolverHint : enum              (highestConfidence | firstWriter |
                                      failOnConflict |
                                      collectAll | compose)
    inferenceServiceNeeded : boolean
    defmanExplorationNeeded : boolean
    externalTools : List<ToolReq>    (name + versionSpec)
    budget : Budget
    --
    NO dependsOn : KSs are unaware of each other.
    Ordering is data-driven via triggerPredicate.
    Engine routes the KS to SourceController or
    TargetController based on targetBlackboard.
  }

  interface InstructionsProvider {
    +InstructionsResult provide(InstructionsContext ctx)
  }

  class InstructionsProviderDescriptor <<descriptor>> {
    id : URI
    instructionsPayloadSchemaRef : URI
    network : enum (deny | allow)
    externalTools : List<ToolReq>
    budget : Budget
    --
    Invoked exactly once per Run by Initializer,
    BEFORE either Controller starts. Returns domain-specific
    RunContext properties; NEVER writes to either Blackboard.
  }

  interface ControlContext <<runtime>> {
    +SourcingRunContext runContext()
    +BlackboardView blackboard()         (the Controller's targeted Blackboard)
    +SourceFreezeView sourceFreeze()     (Target-side only; null on Source side)
    +InferenceService inference()        (if declared)
    +DefManExplorationService defman()   (if declared)
    +Tool tool(String name)              (if declared + bound)
    +BundleStore bundleStore()
    +DiagnosticReporter diagnostics()
  }

  interface BlackboardView <<read-only>> {
    +Optional<Object> resolved(String panelName, String identityKey)
    +List<Contribution> contributionsOf(String panelName, String identityKey)
    +List<Contribution> contributionsOfSlot(String panelName, String slot)
    +boolean contributedBy(URI ksId, String identityKey)
    +void post(Contribution c)
  }

  interface SourceFreezeView <<read-only,immutable>> {
    +boolean has(String packPanelName, String identityKey)
    +List<Contribution> contributionsOf(String packPanelName, String identityKey)
    +List<Contribution> contributionsOfSlot(String packPanelName, String slot)
    +List<AbstractionLayer> abstractionLayers()
  }

  class Contribution <<wire,abstract>> {
    id : String
    panel : String                   (panel name)
    slot : String
    value : Object
    contributorKsId : URI            (engine-set)
    confidence : double [0..1]
    rationale : String?
    evidence : List<EvidenceRef>     (optional; replaces Wave-9-dropped Evidence panel)
    cacheKey : String                (required if producing KS is NON_DETERMINISTIC)
    derivedFrom : List<String>
    supersedes : List<String>        (engine-set on override)
    diagnostics : List<Diagnostic>
    createdAt : Instant
    --
    Sealed over: SourceContribution (no extra fields, hosted on SourceBlackboard)
              | TargetContribution (adds targetIdentityKey: String, hosted on TargetBlackboard).
    No `kind` or `determinism` field on Contribution: provenance class is read
    from contributorKsId; determinism is a property of the producing KS.
  }

  class EvidenceRef <<value>> {
    source : String?     (URI, file path, or other identifier)
    kind : String        (e.g. STATIC_SCAN, LLM_AGREEMENT, COUNTER_EXAMPLE)
    weight : double      ([-1..1]; negative = counter-evidence)
    note : String?
  }

  KnowledgeSource --> KnowledgeSourceDescriptor : declared by
  KnowledgeSource --> ControlContext : uses (sole IO)
  ControlContext --> BlackboardView
  ControlContext --> SourceFreezeView : (Target side only)
  KnowledgeSource --> Contribution : returns 0..n
  Contribution --> EvidenceRef : evidence
  InstructionsProvider --> InstructionsProviderDescriptor : declared by

  note as N_DSL
    **triggerPredicate (Java; no DSL)**

    Each KS supplies a Java class implementing the engine's
    `KsTriggerPredicate` interface:

      ```
      interface KsTriggerPredicate {
        boolean test(BlackboardView view,
                     SourcingRunContext ctx);
      }
      ```

    The Sourcer Controller invokes `test(...)` once per scheduling
    tick to decide whether the KS is firable. Predicates are pure
    reads against the typed `BlackboardView` and the frozen
    `SourcingRunContext` — no string parsing, no scripting.

    `BlackboardView` exposes the typed accessors a predicate needs:

    Per-identity:
      view.resolved(panelName, identityKey)
      view.contributionsOf(panelName, identityKey)
      view.contributionsOfSlot(panelName, slot)
      view.contributedBy(thisKsId, identityKey)
      ctx.scope().includes(identityKey)

    Target-side only (read frozen Source):
      ctx.sourceFreeze().has(packPanelName, identityKey)
      ctx.sourceFreeze().contributionsOf(packPanelName, identityKey)

    Revision (re-fire even when upstream is resolved):
      view.confidenceBelow(identityKey, threshold)
      view.statementAmbiguous(identityKey)
      view.validationFailed(identityKey)

    Aggregate (cross-identity):
      view.count(predicate)

    Example predicate body:

      ```
      // ArchetypeMatchingKS
      return view.resolved("Definition", id) != null
          && view.contributionsOf("Archetype", id).isEmpty()
          && !view.contributedBy(thisKsId(), id);
      ```
  end note

  note as N_Tools
    **External tools (3-layer authorization)**
    1. Pack manifest declares upper bound
       (requestedExternalTools[])
    2. RunConfig binds names -> host paths
       (externalToolBindings[])
    3. Sandbox execve is restricted to bindings
    KSs invoke via ctx.tool(name); engine returns
    a sandboxed handle. Output flows through BundleStore.
  end note
}

@enduml
