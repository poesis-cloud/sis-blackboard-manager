@startuml gsm-sourcer-component

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F8FA
skinparam packageBorderColor #57606A
skinparam componentBackgroundColor #FFFFFF
skinparam componentBorderColor #57606A
skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

frame "PD - GSM Sourcer - Component view" {

  package "API surface" as API_PKG {
    component "Sourcer API\n(POST /runs, GET /runs/{id},\n /runs/{id}/blackboard)" as API
  }

  package "Initialization" as INIT_PKG {
    component "Initializer\n(orchestrates substeps below;\nfreezes SourcingRunContext;\nstarts Control)" as Init
    component "Plug-in Loader\n(sandboxed classloader per Pack)" as Loader
    component "Scope Builder\n(engine default; Pack may override)" as ScopeB
    component "Focus Builder\n(engine default; Pack may override)" as FocusB
    component "Blackboard Builder\n(declares two Blackboards:\n  TargetBlackboard\n    (engine-fixed 3 panels:\n     Definition, Archetype, Statement)\n  SourceBlackboard\n    (Pack-owned panels +\n     Pack-declared abstractionLayers\n     from pack-manifest);\n validates each panel DAG;\n instantiates empty panels)" as BBBuild
  }

  package "Control" as CTRL_PKG {
    component "SourceController\n(panel-DAG-aware scheduler\nover SourceBlackboard;\nfires Source KSs to quiescence)" as SCtrl
    component "TargetController\n(panel-DAG-aware scheduler\nover TargetBlackboard;\nstarts after SourceFreeze)" as TCtrl
    component "Bridge\n(produces deep-immutable\nSourceFreeze on Source quiescence;\ntransfers control to TargetController)" as Bridge
    component "ContributionResolver\n(per (panel, slot): highestConfidence /\nfirstWriter / failOnConflict /\ncollectAll / compose)" as Res
    component "Convergence Detector\n(quiescence: N empty iterations;\nused independently per Controller)" as Conv
  }

  package "Blackboards (in-memory + persisted)" as BB_PKG {
    component "SourceBlackboard\n(Pack-declared panels:\nSourceInventory, SourceUnit,\nSourceRelation, SourceInterface;\nPack-declared abstractionLayers)" as BB_SRC
    component "TargetBlackboard\n(engine-fixed 3-panel spine:\nDefinition, Archetype, Statement;\nTargetLayer enum:\nL_DEFINITION, L_ARCHETYPE, L_STATEMENT)" as BB_TGT
    component "SourceFreeze\n(deep-immutable snapshot of\nSourceBlackboard at quiescence;\nsequential bridge artefact)" as SF
  }

  package "Engine run state\n(distinct from the Blackboard)" as RC_PKG {
    component "SourcingRunContext\n(immutable per Run;\nfrozen by Initializer\nbefore Blackboard Builder runs)" as RC
    component "RunConfig\n(operator input)" as RCfg
  }

  package "Pipeline (engine-only)" as PIPE_PKG {
    component "Validation Stage\n(JSON Schema + GSM invariants)" as Val
    component "Registration Stage\n(POST DefMan DRAFT)" as Reg
    component "ValidatedAscriptionDraft\n+ RegisteredAscription records" as PipeRec
  }

  package "Persistence & I/O" as PERS_PKG {
    component "BundleStore\n(SourceContextSnapshot,\nblackboard snapshots,\nbinary artefacts)" as BS
    component "RunLedger\n(audit: per-iteration,\nresolver decisions)" as RL
  }

  package "Inference & DefMan exploration" as INF_PKG {
    component "InferenceService\n(LLM proxy with per-Run cache)" as Inf
    component "DefManExplorationService\n(read-only navigation)" as DefExp
    component "DefManClient\n(Registration only)" as DM
  }

  package "Sandbox & Tools" as SBX_PKG {
    component "Sandbox\n(network deny, execve allowlist,\nresource limits)" as Sbx
    component "External Tools Adapter\n(scip-*, syft, tokei, joern, ...)" as ExtT
  }

  API --> Init
  Init --> Loader : load Pack
  Loader --> Sbx : classloader
  Init --> ScopeB
  Init --> FocusB
  ScopeB --> RC
  FocusB --> RC
  Init --> RC : freeze
  Init --> BBBuild : after RC freeze
  BBBuild --> BB_SRC : declare + instantiate
  BBBuild --> BB_TGT : declare + instantiate
  Init --> SCtrl : start (Source phase)
  Init --> BS : initial snapshot

  SCtrl --> BB_SRC
  SCtrl --> Res : reconcile (Source side)
  SCtrl --> Conv
  SCtrl --> RL
  SCtrl --> Bridge : on Source quiescence
  Bridge --> SF : produce snapshot
  Bridge --> TCtrl : start (Target phase)

  TCtrl --> BB_TGT
  TCtrl --> SF : read frozen Source
  TCtrl --> Res : reconcile (Target side)
  TCtrl --> Conv
  TCtrl --> RL
  TCtrl --> Val : pass converged tuples
  Val --> PipeRec
  Val --> Reg
  Reg --> DM
  Reg --> PipeRec
  Reg --> RL

  ' KS execution (KSs themselves not shown; loaded by Loader and invoked by Controllers)
  SCtrl ..> Inf : KS-driven
  SCtrl ..> ExtT : KS-driven
  TCtrl ..> Inf : KS-driven
  TCtrl ..> DefExp : KS-driven
  TCtrl ..> ExtT : KS-driven
  ExtT --> Sbx : enforced

  RCfg --> Init
  RC --> SCtrl : runContext()
  RC --> TCtrl : runContext()
  RC --> Sbx : externalToolBindings\n(execve allowlist)

  note bottom of CTRL_PKG
    Two Controllers run **sequentially**: SourceController first
    (to Source quiescence), then Bridge produces SourceFreeze, then
    TargetController starts. Each Controller is panel-graph-agnostic:
    it knows only the DAG of its Blackboard and KS triggerPredicates.
    KS descriptors declare targetBlackboard = source|target so the
    engine routes them to the right Controller; direction = TOP_DOWN
    is a sanctioned exception used only by GranularityKS.
  end note

  note bottom of PIPE_PKG
    Pipeline records are engine state (NOT Blackboard
    panels). Validation and Registration may emit
    diagnostics that re-fire upstream KS triggers
    (capped retries).
  end note

  note bottom of SBX_PKG
    External tools are 3-layer authorized:
    (1) Pack manifest declares the upper bound
        (requestedExternalTools[]).
    (2) RunConfig narrows by binding names to host paths
        (externalToolBindings[]).
    (3) Sandbox execve is restricted to bindings.
  end note
}

@enduml
