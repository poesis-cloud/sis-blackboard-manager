@startuml gsm-sourcer-overview

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F8FA
skinparam packageBorderColor #57606A
skinparam componentBackgroundColor #FFFFFF
skinparam componentBorderColor #57606A
skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

frame "PD - GSM Sourcer - System overview" {

  actor "Run Operator" as Op
  actor "Reviewer\n(checkpoint)" as Rev
  actor "Pack Author" as Author

  package "GSM Sourcer engine\n(IT-domain agnostic, owns the meta-model + GSM target spine)" as Engine {
    component "Sourcer API\n(POST /runs)" as API
    component "Initializer\n(substeps: Plug-in Loader,\n Instructions Provider invocation,\n Scope Builder, Focus Builder,\n freeze SourcingRunContext,\n Blackboard Builder)" as Init
    component "Control\n(panel-DAG-aware scheduler;\nfires KSs whose triggerPredicate\nholds against Blackboard state)" as Ctrl
    component "Blackboard\n(Source group + Target group panels;\nhypothesis-only)" as BB
    component "ContributionResolver\n(per-panel; default + RunConfig overrides)" as Res
    component "Pipeline\n(Validation -> Registration; engine-only)" as Pipe
    component "Checkpoint Mediator\n(governance overlay A/B)" as Chk
    component "DefManClient\n(Registration only)" as DM
    component "BundleStore\n(snapshots; raw & derived artefacts)" as BS
    component "RunLedger\n(audit trail; resolver decisions)" as RL
    component "InferenceService\n(LLM proxy with cache)" as Inf
    component "DefManExplorationService\n(read-only navigation)" as DefExp
  }

  package "Sourcing Pack\n(Pack-shipped, sandboxed; e.g. itip/repository-sourcing-pack/v1)" as Pack {
    component "Instructions Provider\n(plug-in; one per Pack;\nfills SourcingRunContext)" as IP
    component "Source-side panel declarations\n(Pack-owned topology)" as PD_SRC
    component "Knowledge Sources\n(KS JARs; trigger over Blackboard state)" as KS
    component "External tools (whitelisted)\nscip-*, syft, tokei, joern, ..." as Tools
  }

  Op --> API
  API --> Init
  Init --> IP : invoke once\n(returns instructionsPayload + profile)
  Init --> BB : Blackboard Builder substep\n(declare engine target spine\n + Pack source-side panels;\n validate panel DAG;\n instantiate empty panels)
  Init --> Ctrl : start
  Ctrl --> KS : fire eligible KSs
  KS --> BB : post Contribution(panel, slot, value)
  KS --> Inf : optional
  KS --> DefExp : optional (read-only)
  KS --> Tools : execve (sandboxed)
  Ctrl --> Res : reconcile competing contributions
  Ctrl --> Chk : Checkpoint-A (post-convergence)
  Ctrl --> Pipe : hand converged target tuples
  Pipe --> Chk : Checkpoint-B (post-validation)
  Pipe --> DM : POST /ascriptions DRAFT
  Pipe --> RL : record per-stage outcomes
  Init --> BS : sourceContext snapshot
  Rev --> Chk : approve / override / reject

  Author ..> Pack : authors KSs +\nInstructions Provider +\nsource-side panels

  note bottom of Engine
    Engine ships: meta-model (Panel/Contribution/KS/InstructionsProvider),
    target spine (Definition, Archetype, Statement, Granularity, Evidence,
    Confidence), Initializer, Control, ContributionResolver, Pipeline,
    Checkpoint Mediator, BundleStore, RunLedger, InferenceService,
    DefManExplorationService, DefManClient.
  end note

  note bottom of Pack
    Pack ships: an Instructions Provider, source-side panel declarations
    (panel name + closed slot set with per-type value schemas
    + dependsOnPanels), and a set of KS descriptors. The Pack also declares
    requestedExternalTools[] (upper bound). The operator's RunConfig
    narrows tool bindings.
  end note
}

@enduml
