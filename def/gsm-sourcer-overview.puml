@startuml gsm-sourcer-overview

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam roundcorner 12
skinparam ArrowColor #57606A
skinparam DefaultFontName "SansSerif"
skinparam backgroundColor #FFFFFF

skinparam packageStyle rectangle
skinparam packageBackgroundColor #F6F8FA
skinparam packageBorderColor #57606A
skinparam componentBackgroundColor #FFFFFF
skinparam componentBorderColor #57606A
skinparam noteBackgroundColor #FFF8C5
skinparam noteBorderColor #57606A

frame "PD - GSM Sourcer - System overview (canonical Blackboard pattern)" {

  package "Engine (IT-domain agnostic)" as Eng {

    component "Run Control" as RC
    component "Plug-in Resolver" as PR
    component "Control\n(scheduler +\nContributionResolver)" as Ctrl

    package "Blackboard\n(panels = aspects of the problem space)" as BB {
      component "SourceInterpretation\npanel" as P_SI
      component "SubjectIdentity\npanel" as P_ID
      component "Archetyping\npanel" as P_AR
      component "Statement\npanel" as P_ST
      component "Granularity\npanel" as P_GR
      component "Evidence\npanel" as P_EV
      component "Confidence\npanel" as P_CO
    }

    component "Pipeline\n(Validation -> Registration)" as Pipe

    component "Engine utilities\n(Snapshot, BundleStore,\nArchetypeResolver,\nJsonSchemaValidator,\nInferenceService,\nDefManExplorationService,\nDefManClient,\nRunLedger)" as Utils

    RC --> PR
    RC --> Ctrl
    Ctrl --> BB
    BB --> Pipe : converged contributions
    Ctrl --> Utils
    Pipe --> Utils
  }

  package "Sourcing Packs (Java JARs)" as Packs {
    component "ITIP GSM Sourcing Pack" as Itip
    component "Other domain packs\n(legislation, regulatory, ...)" as Other
  }

  package "External" as Ext {
    component "Source artifacts\n(opaque)" as Src
    component "DefMan API" as DM
    component "LLM provider" as LLM
  }

  PR --> Packs : load JARs
  Packs ..> Ctrl : KSs fire via ControlContext\n(KSs unaware of each other)

  Utils --> Src : opaque snapshot
  Utils --> DM : DRAFT + HATEOAS read
  Utils --> LLM : completions (with tool wiring)

  note bottom of BB
    **Canonical Blackboard (Hayes-Roth / Erman-Lesser).**
    Panels = ASPECTS OF THE PROBLEM SPACE.
    Each panel holds Contributions; multiple
    contributions on the same (panel, identity, slot)
    coexist; Control resolves the effective value.
    KSs are aware ONLY of the Blackboard, never of
    each other.
  end note

  note bottom of Pipe
    **Pipeline is NOT part of the Blackboard.**
    Engine-only stages that consume the converged
    Blackboard: schema-Validation -> Checkpoint-B
    -> Registration to DefMan.
  end note
}

@enduml
